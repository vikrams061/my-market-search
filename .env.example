# ---------------------------------------------------------------------------
# Groww API credentials (required)
# Generate these from the Groww API keys page (https://groww.in/trade-api)
# ---------------------------------------------------------------------------
GROWW_API_KEY=your_api_key_here
GROWW_API_SECRET=your_api_secret_here

# Optional: TOTP secret if your API key is configured for TOTP-based login.
# Leave blank to authenticate with API key + secret only.
GROWW_TOTP_SECRET=

# ---------------------------------------------------------------------------
# Watchlist (optional)
# Comma-separated trading symbols to add to the defaults.
# Defaults: equities RELIANCE,TCS,INFY,WIPRO ; indices NIFTY,BANKNIFTY
# ---------------------------------------------------------------------------
EXTRA_SYMBOLS=
EXTRA_INDICES=

# ---------------------------------------------------------------------------
# Data mode (optional)
# USE_FEED=true  -> WebSocket streaming via GrowwFeed (real-time LTP pushes)
# USE_FEED=false -> REST polling via GrowwAPI.get_quote (default)
# ---------------------------------------------------------------------------
USE_FEED=false

# Seconds between quote refreshes in polling mode (default 2.0).
# Groww allows up to ~300 live-data requests/minute.
POLL_INTERVAL_SECONDS=2.0

# Request timeout in seconds (default 10).
REQUEST_TIMEOUT_SECONDS=10

# Feed reconnect backoff settings (only used when USE_FEED=true)
RECONNECT_DELAY_SECONDS=5
MAX_RECONNECT_ATTEMPTS=10

# Logging (DEBUG, INFO, WARNING, ERROR). Log file: market_watch.log
LOG_LEVEL=INFO

# Market data source: "groww" (requires Trading API subscription) or
# "yahoo" (free, ~15-min delayed NSE data via yfinance, no key needed)
DATA_SOURCE=groww

# ---------------------------------------------------------------------------
# Web UI (only used with `python main.py --web` / `python ui.py`)
# WARNING: the dashboard has no authentication. Keep WEB_HOST on loopback
# unless you protect it with a firewall, VPN, or reverse proxy.
# ---------------------------------------------------------------------------
WEB_HOST=127.0.0.1
WEB_PORT=8000
